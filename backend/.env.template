# ====================================
# SENTIMENT MODEL (pick one)
# ====================================

# Option A: HuggingFace API (low RAM, good for deployment)
# Get a free token at: https://huggingface.co/settings/tokens
# HF_TOKEN=your_huggingface_token_here

# Option B: Local model (default when HF_TOKEN is unset)
# Downloads DistilBERT on first run (~250MB). No token needed.
# Leave HF_TOKEN commented out or remove it to use this mode.

# ====================================
# OPTIONAL
# ====================================
# NewsAPI key (used for /api/news/fetch-ma-news feed only)
# Get one at: https://newsapi.org
NEWSAPI_KEY=your_api_key_here

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
